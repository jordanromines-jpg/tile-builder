 "cards": [
  {
   "dot": "cyan",
   "title": "Kid side",
   "items": [
    "Two taps: open the app, tap a project, you're on step 1",
    "Pictures and voice first: a 3-year-old never has to read",
    "Near misses shown as tiles (\"Need 2 more ▲\"), never \"buy more\"",
    "1 / up to 3 / up to 4 tiles a step by age; the model stays still for 3–5"
   ]
  },
  {
   "dot": "emerald",
   "title": "The tile engine",
   "items": [
    "Every project is hand-written and passes the checker under every brand's tall triangle",
    "Edges meet, no overlaps, grounded, layer by layer, every in-between state stands",
    "Matching counts by shape; colour is a preference, never a requirement"
   ]
  },
  {
   "dot": "violet",
   "title": "Grown-ups side",
   "items": [
    "Start from one of 5 set presets, then adjust",
    "Voice, sound and storage settings",
    "A backup file to move iPads or recover"
   ]
  },
  {
   "dot": "slate",
   "title": "Not in the app (D18)",
   "items": [
    "No profiles or avatars",
