{
  "name": "tile-steps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tile Steps: pick a magnet-tile project you can build with your tiles, and build it, step by step. A web app for iPads, offline, nothing leaves the device.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:projects": "vite-node scripts/check-projects.ts",
    "check:physics": "node scripts/check-physics.mjs",
    "size": "node scripts/size.mjs",
    "icons": "node scripts/icons.mjs",
    "pictures": "node scripts/pictures.mjs",
    "projects": "vite-node scripts/projects.ts",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource/andika": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-toast": "1.2.23",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.1.3",
    "@tanstack/react-router": "1.170.41",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "motion": "13.5.0",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
